# Copy to .env.local for development. Set the real values in the Vercel
# project's Environment Variables tab for production.

# Guards /api/revalidate. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Vercel sends this as `Authorization: Bearer <value>` on cron invocations.
# Set it to the SAME value as REVALIDATE_SECRET or the cron will 401.
CRON_SECRET=

# Optional analytics. Left unset, no third-party scripts are loaded at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Optional cross-posting, used only by the manual Syndicate workflow.
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
GOOGLE_INDEXING_API_KEY=
